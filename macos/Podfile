platform :osx, '10.15'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

require 'shellwords'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'ephemeral', 'Flutter-Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure \"flutter pub get\" is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Flutter-Generated.xcconfig, then run \"flutter pub get\""
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)
require_relative 'tool/managed_cmake'

# flutter_soloud 4.1.7 still compiles its macOS native library through CMake.
# Flutter 3.41.9 cannot resolve flutter_soloud 5.x, so keep the compatible
# plugin version and make the CMake prerequisite self-healing instead of
# requiring every developer to install Homebrew/CMake manually.
lyric_forge_cmake_bin = LyricForgeManagedCMake.ensure!
ENV['PATH'] = "#{lyric_forge_cmake_bin}:#{ENV.fetch('PATH', '')}"

flutter_macos_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_macos_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  cmake_path_prefix = Shellwords.escape(lyric_forge_cmake_bin)
  upstream_path_line = 'export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"'
  resolved_path_line =
    "export PATH=#{cmake_path_prefix}:/opt/homebrew/bin:/usr/local/bin:\"$PATH\""

  installer.pods_project.targets.each do |target|
    flutter_additional_macos_build_settings(target)

    next unless target.name == 'flutter_soloud'

    target.shell_script_build_phases.each do |phase|
      next unless phase.name.to_s.include?('Build flutter_soloud with CMake')

      marker = '# LyricForge managed CMake PATH'
      script = phase.shell_script.to_s
      next if script.include?(marker)

      # flutter_soloud 4.1.7 prepends Homebrew paths inside its own phase. Replace
      # that line so our resolved CMake directory remains first; otherwise a CI
      # runner with CMake preinstalled could make the managed-fallback test pass
      # without actually exercising the downloaded tool.
      script = if script.include?(upstream_path_line)
                 script.sub(upstream_path_line, resolved_path_line)
               else
                 "#{resolved_path_line}\n#{script}"
               end
      phase.shell_script = "#{marker}\n#{script}"
    end
  end
end
