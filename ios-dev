#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$ROOT_DIR"

COMMAND="${1:-help}"
if [[ $# -gt 0 ]]; then shift; fi

RUN_AFTER_BUILD=0
CLEAN_FIRST=0
SKIP_PUB=0
SIMULATOR_BUILD=0
DEVICE_ID=""

usage() {
  cat <<'EOF'
LyricForge iOS developer helper

Usage:
  ./ios-dev build                Build iOS Debug app
  ./ios-dev build --run          Pick an iPhone/Simulator, then Build + Run Debug
  ./ios-dev run                  Same as ./ios-dev build --run
  ./ios-dev devices              Show active iOS devices

Options:
  --run                      Pick device and run Debug after build command
  --device <id>              Skip picker and use a Flutter device ID
  --simulator                Build simulator Debug app when not using --run
  --clean                    flutter clean before building/running
  --no-pub                   Skip conditional flutter pub get
  -h, --help                 Show this help

Device picker:
  ↑ / ↓                      Move highlight
  Space                      Select highlighted device
  Enter                      Confirm selected/highlighted device and start
  q                          Cancel

Examples:
  ./ios-dev build --run
  ./ios-dev run
  ./ios-dev build --run --clean
  ./ios-dev build --device 00008110-001234567890001E --run
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --run)
      RUN_AFTER_BUILD=1
      shift
      ;;
    --device)
      [[ $# -ge 2 ]] || { echo "Missing value for --device" >&2; exit 2; }
      DEVICE_ID="$2"
      shift 2
      ;;
    --simulator)
      SIMULATOR_BUILD=1
      shift
      ;;
    --clean)
      CLEAN_FIRST=1
      shift
      ;;
    --no-pub)
      SKIP_PUB=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      usage
      exit 2
      ;;
  esac
done

if [[ "$COMMAND" == "run" ]]; then
  COMMAND="build"
  RUN_AFTER_BUILD=1
fi

if [[ "$COMMAND" == "help" || "$COMMAND" == "--help" || "$COMMAND" == "-h" ]]; then
  usage
  exit 0
fi

if [[ "$COMMAND" != "build" && "$COMMAND" != "devices" ]]; then
  echo "Unknown command: $COMMAND" >&2
  usage
  exit 2
fi

if [[ "$(uname -s)" != "Darwin" ]]; then
  echo "This helper is for macOS iOS development." >&2
  exit 1
fi

if ! command -v flutter >/dev/null 2>&1; then
  echo "flutter was not found in PATH." >&2
  exit 1
fi

if ! xcode-select -p >/dev/null 2>&1; then
  echo "Xcode Command Line Tools are not configured. Run: sudo xcode-select -s /Applications/Xcode.app/Contents/Developer" >&2
  exit 1
fi

DEVICE_NAMES=()
DEVICE_IDS=()
DEVICE_DETAILS=()

refresh_devices() {
  DEVICE_NAMES=()
  DEVICE_IDS=()
  DEVICE_DETAILS=()

  while IFS=$'\t' read -r name id detail; do
    [[ -n "$id" ]] || continue
    DEVICE_NAMES+=("$name")
    DEVICE_IDS+=("$id")
    DEVICE_DETAILS+=("$detail")
  done < <(
    flutter devices --device-timeout 10 2>/dev/null |
      awk -F ' • ' '
        NF >= 4 {
          platform=$3
          gsub(/^[[:space:]]+|[[:space:]]+$/, "", platform)
          if (platform == "ios") {
            name=$1; id=$2; detail=$4
            gsub(/^[[:space:]]+|[[:space:]]+$/, "", name)
            gsub(/^[[:space:]]+|[[:space:]]+$/, "", id)
            gsub(/^[[:space:]]+|[[:space:]]+$/, "", detail)
            printf "%s\t%s\t%s\n", name, id, detail
          }
        }
      '
  )
}

print_devices() {
  refresh_devices
  if [[ ${#DEVICE_IDS[@]} -eq 0 ]]; then
    echo "No active iPhone or iOS Simulator found."
    return 1
  fi
  local i
  for ((i=0; i<${#DEVICE_IDS[@]}; i++)); do
    printf '%2d. %s\n    %s\n    %s\n' "$((i + 1))" "${DEVICE_NAMES[$i]}" "${DEVICE_DETAILS[$i]}" "${DEVICE_IDS[$i]}"
  done
}

try_open_simulator_if_needed() {
  refresh_devices
  [[ ${#DEVICE_IDS[@]} -eq 0 ]] || return 0

  if command -v open >/dev/null 2>&1; then
    echo "No active iOS device found. Opening Simulator and retrying..." >&2
    open -a Simulator >/dev/null 2>&1 || true
    local attempt
    for attempt in 1 2 3 4 5; do
      sleep 2
      refresh_devices
      [[ ${#DEVICE_IDS[@]} -gt 0 ]] && return 0
    done
  fi

  echo "No active iPhone or iOS Simulator found." >&2
  echo "For a physical iPhone: unlock it, trust this Mac, enable Developer Mode, then reconnect." >&2
  echo "For Simulator: open Xcode > Open Developer Tool > Simulator, boot a device, then retry." >&2
  return 1
}

pick_device() {
  try_open_simulator_if_needed || return 1

  local index=0
  local selected=-1
  local key=""
  local rest=""
  local count=${#DEVICE_IDS[@]}

  if [[ ! -t 0 ]]; then
    echo "No interactive terminal; using first iOS device: ${DEVICE_NAMES[0]}" >&2
    printf '%s' "${DEVICE_IDS[0]}"
    return 0
  fi

  tput civis 2>/dev/null || true
  trap 'tput cnorm 2>/dev/null || true' EXIT INT TERM

  while true; do
    printf '\033[2J\033[H' >&2
    echo "Select iPhone / iOS Simulator" >&2
    echo "↑/↓ move · Space select · Enter run · q cancel" >&2
    echo >&2

    local i marker cursor
    for ((i=0; i<count; i++)); do
      marker='[ ]'
      cursor='  '
      [[ $i -eq $selected ]] && marker='[✓]'
      [[ $i -eq $index ]] && cursor='› '
      printf '%s%s %s\n' "$cursor" "$marker" "${DEVICE_NAMES[$i]}" >&2
      printf '       %s\n' "${DEVICE_DETAILS[$i]}" >&2
      printf '       %s\n' "${DEVICE_IDS[$i]}" >&2
    done

    IFS= read -rsn1 key || true
    if [[ "$key" == $'\x1b' ]]; then
      IFS= read -rsn2 rest || true
      key+="$rest"
    fi

    case "$key" in
      $'\x1b[A')
        index=$(( (index - 1 + count) % count ))
        ;;
      $'\x1b[B')
        index=$(( (index + 1) % count ))
        ;;
      ' ')
        selected=$index
        ;;
      '')
        [[ $selected -ge 0 ]] || selected=$index
        break
        ;;
      q|Q)
        tput cnorm 2>/dev/null || true
        trap - EXIT INT TERM
        echo >&2
        echo "Cancelled." >&2
        return 1
        ;;
    esac
  done

  tput cnorm 2>/dev/null || true
  trap - EXIT INT TERM
  printf '\033[2J\033[H' >&2
  echo "Selected: ${DEVICE_NAMES[$selected]} (${DEVICE_DETAILS[$selected]})" >&2
  printf '%s' "${DEVICE_IDS[$selected]}"
}

maybe_pub_get() {
  [[ $SKIP_PUB -eq 0 ]] || return 0

  local package_config='.dart_tool/package_config.json'
  if [[ ! -f "$package_config" || pubspec.yaml -nt "$package_config" || ( -f pubspec.lock && pubspec.lock -nt "$package_config" ) ]]; then
    echo "==> flutter pub get"
    flutter pub get
  else
    echo "==> Dependencies are up to date; skipping flutter pub get"
  fi
}

if [[ "$COMMAND" == "devices" ]]; then
  print_devices
  exit $?
fi

if [[ $CLEAN_FIRST -eq 1 ]]; then
  echo "==> flutter clean"
  flutter clean
fi

maybe_pub_get

if [[ $RUN_AFTER_BUILD -eq 1 ]]; then
  if [[ -z "$DEVICE_ID" ]]; then
    DEVICE_ID="$(pick_device)"
  fi

  echo
  echo "==> Build + Run Debug on: $DEVICE_ID"
  echo "    Flutter will reuse incremental build artifacts on later runs."
  exec flutter run --debug -d "$DEVICE_ID"
fi

echo
if [[ $SIMULATOR_BUILD -eq 1 ]]; then
  echo "==> Build iOS Simulator Debug"
  exec flutter build ios --simulator --debug
else
  echo "==> Build iOS Device Debug"
  exec flutter build ios --debug
fi
