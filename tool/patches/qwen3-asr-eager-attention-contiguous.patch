+    #[test]
+    fn test_eager_attention_matmul_materializes_transposed_inputs() -> anyhow::Result<()> {
+        let device = candle_core::Device::Cpu;
+        let base =
+            candle_core::Tensor::arange(0f32, 40f32, &device)?.reshape((5usize, 2usize, 4usize))?;
+        let q_view = base.transpose(0, 1)?.unsqueeze(0)?;
+        let k_t_view = base.transpose(0, 1)?.unsqueeze(0)?.transpose(2, 3)?;
+        if q_view.is_contiguous() || k_t_view.is_contiguous() {
+            anyhow::bail!("test setup must create non-contiguous attention views");
+        }
+
+        let q = contiguous_for_attention_matmul(q_view)?;
+        let k_t = contiguous_for_attention_matmul(k_t_view)?;
+        if !q.is_contiguous() || !k_t.is_contiguous() {
+            anyhow::bail!("eager matmul inputs must be contiguous");
+        }
+
+        let output = q.matmul(&k_t)?;
+        if output.dims() != vec![1usize, 2usize, 5usize, 5usize] {
+            anyhow::bail!("unexpected attention output shape: {:?}", output.dims());
+        }
+        Ok(())
+    }
