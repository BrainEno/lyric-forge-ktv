+    let response = ureq::post(url.as_str())
+        .set("content-type", "application/json")
+        .set("x-lyricforge-session-auth", auth.as_str())
+        .send_string(body.as_str())
+        .map_err(|error| anyhow::anyhow!("authenticated SSE request failed: {error}"))?;
+    if response.status() != 200 {
+        bail!("expected authenticated SSE status 200, got {}", response.status());
+    }
+    let header_proof = response
+        .header("x-lyricforge-session-proof")
+        .ok_or_else(|| anyhow::anyhow!("missing authenticated SSE response proof"))?;
+    let expected_header = expected_session_response_proof(&secret, &nonce, 200, &[]);
+    if header_proof != expected_header {
+        bail!("authenticated SSE response handshake proof did not match");
+    }
+    let response_body = response
+        .into_string()
+        .context("failed reading authenticated SSE response")?;
+
+    let normalized_body = response_body.replace("\r\n", "\n");
+    let mut verified_events = 0usize;
+    for block in normalized_body.split("\n\n") {
+        let proof = block.lines().find_map(|line| {
+            line.strip_prefix(": lyricforge-qwen-stream-proof-v1 ")
+        });
+        let data = block
+            .lines()
+            .find_map(|line| line.strip_prefix("data: "));
+        let Some(data) = data else {
+            continue;
+        };
+        let comment = proof
+            .ok_or_else(|| anyhow::anyhow!("SSE data event omitted its proof comment"))?;
+        let mut fields = comment.split_whitespace();
+        let proof_nonce = fields.next().unwrap_or_default();
+        let sequence = fields
+            .next()
+            .ok_or_else(|| anyhow::anyhow!("SSE proof omitted its sequence"))?
+            .parse::<u64>()?;
+        let proof = fields
+            .next()
+            .ok_or_else(|| anyhow::anyhow!("SSE proof omitted its HMAC"))?;
+        if fields.next().is_some() {
