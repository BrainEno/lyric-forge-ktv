+            bail!("authenticated SSE events were missing, repeated, or reordered");
+        }
+        if proof != expected_session_stream_proof(&secret, &nonce, sequence, data) {
+            bail!("authenticated SSE event proof did not match its data");
+        }
+        verified_events += 1;
+    }
+    if verified_events == 0 {
+        bail!("authenticated SSE stream returned no proof-verified events");
