+fn hex_encode(bytes: &[u8]) -> String {
+    const HEX: &[u8; 16] = b"0123456789abcdef";
+    let mut output = String::with_capacity(bytes.len() * 2);
+    for byte in bytes {
+        output.push(HEX[(byte >> 4) as usize] as char);
+        output.push(HEX[(byte & 0x0f) as usize] as char);
+    }
+    output
+}
+
+fn session_request_header(
+    secret: &[u8; 32],
+    method: &str,
+    path: &str,
+    body: &[u8],
+    nonce: &str,
+) -> String {
+    let body_hash = Sha256::digest(body);
+    let canonical = format!(
+        "lyricforge-qwen-request-v1\n{}\n{}\n{}\n{}",
+        method,
+        path,
+        hex_encode(&body_hash),
+        nonce,
+    );
+    let mut mac = Hmac::<Sha256>::new_from_slice(secret).expect("valid HMAC key");
+    mac.update(canonical.as_bytes());
+    format!("{nonce}:{}", hex_encode(&mac.finalize().into_bytes()))
+}
+
+fn expected_session_response_proof(
+    secret: &[u8; 32],
+    nonce: &str,
+    status: u16,
+    body: &[u8],
+) -> String {
+    let body_hash = Sha256::digest(body);
+    let canonical = format!(
+        "lyricforge-qwen-response-v1\n{nonce}\n{status}\n{}",
+        hex_encode(&body_hash),
+    );
+    let mut mac = Hmac::<Sha256>::new_from_slice(secret).expect("valid HMAC key");
+    mac.update(canonical.as_bytes());
+    hex_encode(&mac.finalize().into_bytes())
+}
+
+fn expected_session_stream_proof(
+    secret: &[u8; 32],
+    nonce: &str,
+    sequence: u64,
+    data: &str,
+) -> String {
+    let data_hash = Sha256::digest(data.as_bytes());
+    let canonical = format!(
+        "lyricforge-qwen-stream-v1\n{nonce}\n{sequence}\n{}",
+        hex_encode(&data_hash),
+    );
+    let mut mac = Hmac::<Sha256>::new_from_slice(secret).expect("valid HMAC key");
+    mac.update(canonical.as_bytes());
+    hex_encode(&mac.finalize().into_bytes())
+}
+
+fn expected_session_ws_response_proof(
+    secret: &[u8; 32],
+    nonce: &str,
+    sequence: u64,
+    payload: &Value,
+) -> String {
+    let body_hash = Sha256::digest(payload.to_string().as_bytes());
+    let canonical = format!(
+        "lyricforge-qwen-ws-response-v1\n{nonce}\n{sequence}\n{}",
+        hex_encode(&body_hash),
+    );
+    let mut mac = Hmac::<Sha256>::new_from_slice(secret).expect("valid HMAC key");
+    mac.update(canonical.as_bytes());
+    hex_encode(&mac.finalize().into_bytes())
+}
+
+fn authenticated_get(
+    base_url: &str,
+    path: &str,
+    secret: &[u8; 32],
+    nonce: &str,
+) -> Result<(u16, Value, Option<String>, String)> {
+    let url = format!("{base_url}{path}");
+    let auth = session_request_header(secret, "GET", path, &[], nonce);
+    let response = match ureq::get(url.as_str())
+        .set("x-lyricforge-session-auth", auth.as_str())
+        .call()
+    {
+        Ok(response) => response,
+        Err(ureq::Error::Status(_, response)) => response,
+        Err(err) => bail!("authenticated GET {path} failed: {err}"),
+    };
+    let status = response.status();
+    let proof = response.header("x-lyricforge-session-proof").map(str::to_owned);
+    let response_body = response
+        .into_string()
+        .context("failed reading authenticated GET response body")?;
+    if status != 401 {
+        let expected = expected_session_response_proof(
+            secret,
+            nonce,
+            status,
+            response_body.as_bytes(),
+        );
+        if proof.as_deref() != Some(expected.as_str()) {
+            bail!("authenticated GET {path} response body proof did not match");
+        }
+    }
+    let body = if status == 401 {
+        Value::Null
+    } else {
+        serde_json::from_str(&response_body).context("failed parsing authenticated GET response")?
+    };
+    Ok((status, body, proof, response_body))
+}
+
+fn authenticated_post(
+    base_url: &str,
+    path: &str,
+    secret: &[u8; 32],
+    nonce: &str,
+    payload: &Value,
+) -> Result<(u16, Value, Option<String>, String)> {
+    let url = format!("{base_url}{path}");
+    let body = payload.to_string();
+    let auth = session_request_header(secret, "POST", path, body.as_bytes(), nonce);
+    let response = match ureq::post(url.as_str())
+        .set("content-type", "application/json")
+        .set("x-lyricforge-session-auth", auth.as_str())
+        .send_string(body.as_str())
+    {
+        Ok(response) => response,
+        Err(ureq::Error::Status(_, response)) => response,
+        Err(err) => bail!("authenticated POST {path} failed: {err}"),
+    };
+    let status = response.status();
+    let proof = response.header("x-lyricforge-session-proof").map(str::to_owned);
+    let response_body = response
+        .into_string()
+        .context("failed reading authenticated POST response body")?;
+    if status != 401 {
+        let expected = expected_session_response_proof(
+            secret,
+            nonce,
+            status,
+            response_body.as_bytes(),
+        );
+        if proof.as_deref() != Some(expected.as_str()) {
+            bail!("authenticated POST {path} response body proof did not match");
+        }
+    }
+    let body = if status == 401 {
+        Value::Null
+    } else {
+        serde_json::from_str(&response_body).context("failed parsing authenticated POST response")?
+    };
+    Ok((status, body, proof, response_body))
+}
+
+fn spawn_authenticated_mock_server() -> Result<(ChildGuard, String, [u8; 32])> {
+    let secret = [0x5au8; 32];
+    let bootstrap = base64::engine::general_purpose::URL_SAFE_NO_PAD.encode(secret);
+    let mut cmd = Command::new(env!("CARGO_BIN_EXE_qwen3-asr"));
+    cmd.arg("--device")
+        .arg("cpu")
+        .arg("--dtype")
+        .arg("f32")
+        .arg("serve")
+        .arg("--model")
+        .arg("mock-model")
+        .arg("--host")
+        .arg("127.0.0.1")
+        .arg("--port")
+        .arg("0")
+        .arg("--mock")
+        .arg("--session-auth-stdin")
+        .stdin(Stdio::piped())
+        .stdout(Stdio::piped())
+        .stderr(Stdio::null());
+    let mut child = cmd.spawn().context("failed to spawn authenticated mock server")?;
+    let mut stdin = child.stdin.take().context("missing runtime stdin pipe")?;
+    writeln!(stdin, "{bootstrap}")?;
+    drop(stdin);
+
+    let stdout = child.stdout.take().context("missing runtime stdout pipe")?;
+    let mut reader = BufReader::new(stdout);
+    let mut line = String::new();
+    let port = loop {
+        line.clear();
+        if reader.read_line(&mut line)? == 0 {
+            bail!("authenticated mock runtime exited before reporting its bound port");
+        }
+        if let Some(port) = line.trim().strip_prefix("LYRICFORGE_QWEN_READY_V1 ") {
+            break port.parse::<u16>().context("invalid reported runtime port")?;
+        }
+    };
+    if port == 0 {
+        bail!("runtime did not report an operating-system assigned port");
+    }
+    Ok((ChildGuard::new(child), format!("http://127.0.0.1:{port}"), secret))
+}
