+#[cfg(windows)]
+mod windows_exclusive {
+    use std::os::windows::io::AsRawSocket;
+
+    use anyhow::{Result, bail};
+
+    const SOL_SOCKET: i32 = 0xffff;
+    /// winsock2.h: `#define SO_EXCLUSIVEADDRUSE ((int)(~SO_REUSEADDR))`, SO_REUSEADDR = 4.
+    const SO_EXCLUSIVEADDRUSE: i32 = !0x0004;
+
+    #[link(name = "ws2_32")]
+    #[allow(non_snake_case)]
+    unsafe extern "system" {
+        fn setsockopt(s: usize, level: i32, optname: i32, optval: *const u8, optlen: i32) -> i32;
+        fn WSAGetLastError() -> i32;
+    }
+
+    pub fn enable(socket: &tokio::net::TcpSocket) -> Result<()> {
+        let enabled: i32 = 1;
+        // SAFETY: the raw socket is owned by `socket` for the duration of the
+        // call and `optval` points at a live i32 of the length passed.
+        let status = unsafe {
+            setsockopt(
+                socket.as_raw_socket() as usize,
+                SOL_SOCKET,
+                SO_EXCLUSIVEADDRUSE,
+                std::ptr::from_ref(&enabled).cast::<u8>(),
+                std::mem::size_of::<i32>() as i32,
+            )
+        };
+        if status != 0 {
+            // SAFETY: plain thread-local error query with no arguments.
+            let code = unsafe { WSAGetLastError() };
+            bail!("failed to enable SO_EXCLUSIVEADDRUSE on the HTTP listener (WSA error {code})");
+        }
+        Ok(())
+    }
+}
