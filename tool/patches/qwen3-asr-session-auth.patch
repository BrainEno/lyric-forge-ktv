+//! LyricForge session-auth integration tests (`--lyricforge-session-stdin`).
+//!
+//! These run the real `qwen3-asr serve --mock` binary, so they exercise clap
+//! wiring, stdin secret delivery, the runtime-owned port-0 bind, the stdout
+//! ready announcement, the axum middleware and the stdin-EOF shutdown without
+//! downloading models or touching a GPU.
+
+use std::io::{BufRead, BufReader, Read, Write};
+use std::process::{Child, ChildStdin, Command, Stdio};
+use std::sync::mpsc;
+use std::thread;
+use std::time::{Duration, Instant, SystemTime, UNIX_EPOCH};
+
+use anyhow::{Context, Result, bail};
+use serde_json::Value;
+use sha2::{Digest, Sha256};
+
+const READY_PREFIX: &str = "LYRICFORGE_RUNTIME_READY ";
+const SECRET_A: &str = "4c7952696346f2a76525e5f2b8c13a7d0e6f3f1a9b2c4d5e6f708192a3b4c5d6";
+const SECRET_B: &str = "a1b2c3d4e5f60718293a4b5c6d7e8f90112233445566778899aabbccddeeff00";
+
+struct SessionServer {
+    child: Child,
+    stdin: Option<ChildStdin>,
+    port: u16,
+    key: Vec<u8>,
+}
+
+impl Drop for SessionServer {
+    fn drop(&mut self) {
+        drop(self.stdin.take());
+        let _ = self.child.kill();
+        let _ = self.child.wait();
+    }
+}
+
+impl SessionServer {
+    fn base_url(&self) -> String {
+        format!("http://127.0.0.1:{}", self.port)
+    }
+}
+
+fn session_command(extra_args: &[&str]) -> Command {
+    let mut cmd = Command::new(env!("CARGO_BIN_EXE_qwen3-asr"));
+    cmd.args([
+        "--device",
+        "cpu",
+        "--dtype",
+        "f32",
+        "serve",
+        "--model",
+        "mock-model",
+        "--mock",
+        "--lyricforge-session-stdin",
+    ])
+    .args(extra_args)
+    .stdin(Stdio::piped())
+    .stdout(Stdio::piped())
+    .stderr(Stdio::null());
+    cmd
+}
+
+fn spawn_session_server(secret_hex: &str) -> Result<SessionServer> {
+    let mut child = session_command(&["--host", "127.0.0.1", "--port", "0"])
+        .spawn()
+        .context("failed to spawn session-mode mock server")?;
+    let mut stdin = child.stdin.take().context("missing child stdin")?;
+    writeln!(stdin, "{secret_hex}")?;
+    stdin.flush()?;
+    let stdout = child.stdout.take().context("missing child stdout")?;
+    let (tx, rx) = mpsc::channel::<String>();
+    // Keep draining stdout for the whole child lifetime so it never blocks.
+    thread::spawn(move || {
+        for line in BufReader::new(stdout).lines() {
+            let Ok(line) = line else { break };
+            if let Some(rest) = line.strip_prefix(READY_PREFIX) {
+                let _ = tx.send(rest.to_string());
+            }
+        }
+    });
+    let key = decode_hex(secret_hex);
+    let mut server = SessionServer {
+        child,
+        stdin: Some(stdin),
+        port: 0,
+        key,
+    };
+    let ready = rx
+        .recv_timeout(Duration::from_secs(60))
+        .context("session server did not announce its port")?;
+    let ready: Value = serde_json::from_str(&ready).context("ready line is not JSON")?;
+    if ready.get("protocol").and_then(Value::as_u64) != Some(1) {
+        bail!("unexpected ready protocol: {ready}");
+    }
+    let port = ready
+        .get("port")
+        .and_then(Value::as_u64)
+        .and_then(|port| u16::try_from(port).ok())
+        .filter(|port| *port != 0)
+        .context("ready line has no usable port")?;
+    let proof = ready
+        .get("proof")
+        .and_then(Value::as_str)
+        .context("ready line has no proof")?;
+    if proof != hmac_hex(&server.key, &format!("v1-ready\n{port}")) {
+        bail!("ready proof does not match the session secret");
+    }
+    if ready.to_string().contains(secret_hex) {
+        bail!("ready line leaked the session secret");
+    }
+    server.port = port;
+    Ok(server)
+}
+
+struct Reply {
+    status: u16,
+    proof: Option<String>,
+    cors_origin: Option<String>,
+    connection: Option<String>,
+    body: Vec<u8>,
+}
+
+impl Reply {
+    fn json(&self) -> Value {
+        serde_json::from_slice(&self.body).unwrap_or(Value::Null)
+    }
+
+    fn text(&self) -> String {
+        String::from_utf8_lossy(&self.body).into_owned()
+    }
+}
+
+fn into_reply(response: ureq::Response) -> Result<Reply> {
+    let status = response.status();
+    let proof = response.header("x-lyricforge-proof").map(str::to_string);
+    let cors_origin = response
+        .header("access-control-allow-origin")
+        .map(str::to_string);
+    let connection = response.header("connection").map(str::to_ascii_lowercase);
+    let mut body = Vec::new();
+    response
+        .into_reader()
+        .read_to_end(&mut body)
+        .context("failed to read response body")?;
+    Ok(Reply {
+        status,
+        proof,
+        cors_origin,
+        connection,
+        body,
+    })
+}
+
+fn send(
+    base_url: &str,
+    method: &str,
+    path: &str,
+    headers: &[(&str, String)],
+    body: &[u8],
+) -> Result<Reply> {
+    // One fresh connection per request: the runtime closes every connection
+    // it rejects, and ureq never retries a POST on a stale pooled socket.
+    let agent = ureq::AgentBuilder::new().max_idle_connections(0).build();
+    let mut request = agent
+        .request(method, &format!("{base_url}{path}"))
+        .timeout(Duration::from_secs(10));
+    for (name, value) in headers {
+        request = request.set(name, value);
+    }
+    if !body.is_empty() {
+        request = request.set("content-type", "application/json");
+    }
+    match request.send_bytes(body) {
+        Ok(response) | Err(ureq::Error::Status(_, response)) => into_reply(response),
+        Err(error) => bail!("request error for {method} {path}: {error}"),
+    }
+}
+
+struct Signed {
+    nonce: String,
+    headers: Vec<(&'static str, String)>,
+}
+
+fn sign(key: &[u8], method: &str, path: &str, body: &[u8]) -> Signed {
+    sign_at(key, method, path, body, unix_millis(), &fresh_nonce())
+}
+
+fn sign_at(key: &[u8], method: &str, path: &str, body: &[u8], ts: u64, nonce: &str) -> Signed {
+    let message = format!(
+        "v1-request\n{method}\n{path}\n{ts}\n{nonce}\n{}",
+        sha256_hex(body)
+    );
+    Signed {
+        nonce: nonce.to_string(),
+        headers: vec![
+            ("x-lyricforge-timestamp", ts.to_string()),
+            ("x-lyricforge-nonce", nonce.to_string()),
+            ("x-lyricforge-signature", hmac_hex(key, &message)),
+        ],
+    }
+}
+
+fn expected_proof(key: &[u8], nonce: &str, reply: &Reply) -> String {
+    hmac_hex(
+        key,
+        &format!(
+            "v1-response\n{nonce}\n{}\n{}",
+            reply.status,
+            sha256_hex(&reply.body)
+        ),
+    )
+}
+
+fn assert_unauthorized(reply: &Reply, context: &str) -> Result<()> {
+    if reply.status != 401 {
+        bail!(
+            "{context}: expected 401, got {}: {}",
+            reply.status,
+            reply.text()
+        );
+    }
+    if reply.proof.is_some() {
+        bail!("{context}: rejected responses must not carry a session proof");
+    }
+    if reply.connection.as_deref() != Some("close") {
+        bail!("{context}: rejected connections must be closed, not kept alive");
+    }
+    let message = reply.json()["error"]["message"].as_str().map(str::to_string);
+    if message.as_deref() != Some("unauthorized") {
+        bail!("{context}: unexpected rejection body {}", reply.text());
+    }
+    Ok(())
+}
+
+fn transcribe_body() -> Vec<u8> {
+    serde_json::json!({"audio": "hello", "context": "ctx", "language": "English"})
+        .to_string()
+        .into_bytes()
+}
