+#[test]
+fn session_listener_cannot_be_rebound_by_another_socket() -> Result<()> {
+    let server = spawn_session_server(SECRET_A)?;
+    let addr: std::net::SocketAddr = format!("127.0.0.1:{}", server.port).parse()?;
+
+    let rt = tokio::runtime::Builder::new_current_thread()
+        .enable_all()
+        .build()?;
+    let hijack: std::io::Result<()> = rt.block_on(async {
+        let socket = tokio::net::TcpSocket::new_v4()?;
+        // SO_REUSEADDR is exactly what a same-user hijacker would use on
+        // Windows; the runtime's SO_EXCLUSIVEADDRUSE must defeat it.
+        socket.set_reuseaddr(true)?;
+        #[cfg(all(unix, not(target_os = "solaris"), not(target_os = "illumos")))]
+        socket.set_reuseport(true)?;
+        socket.bind(addr)?;
+        let _listener = socket.listen(16)?;
+        Ok(())
+    });
+    if hijack.is_ok() {
+        bail!("another socket was able to bind and listen on the runtime's port {addr}");
+    }
+
+    let health = sign(&server.key, "GET", "/healthz", b"");
+    let reply = send(&server.base_url(), "GET", "/healthz", &health.headers, b"")?;
+    if reply.status != 200 {
+        bail!("runtime stopped answering after the hijack attempt");
+    }
+    Ok(())
+}
