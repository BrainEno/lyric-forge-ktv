--- /dev/null
+++ b/qwen3_asr_cli/src/session_auth.rs
@@ -0,0 +1,663 @@
+//! LyricForge per-launch session authentication for `qwen3-asr serve`.
+//!
+//! This module is added by LyricForge's `tool/patches/qwen3-asr-session-auth.patch`.
+//! Upstream `serve` has no authentication and answers every local client, so
+//! any process (or any browser page, through the permissive CORS layer) could
+//! make the runtime read arbitrary file paths. With
+//! `--lyricforge-session-stdin` the server instead:
+//!
+//! * reads a 32-byte session secret (64 lowercase hex characters) from the first
+//!   stdin line, so the secret never appears on the command line or in logs;
+//! * binds the listener itself (normally on port 0) with exclusive address use,
+//!   then reports the actual port on stdout, removing the release-then-rebind
+//!   race of a parent-side port reservation;
+//! * requires an HMAC-SHA256 request signature on every route (including
+//!   `/healthz` and CORS preflights) and rejects replayed nonces;
+//! * signs every response with the same secret, so the client can prove it is
+//!   talking to the process it launched and not to a port squatter;
+//! * exits when stdin closes, so the runtime does not outlive its parent.
+//!
+//! The canonical strings are mirrored by
+//! `lib/features/transcription/data/services/qwen_runtime_session.dart`.
+
+use std::collections::HashMap;
+use std::io::{BufRead, Read, Write};
+use std::net::{IpAddr, SocketAddr};
+use std::sync::{Arc, Mutex};
+use std::time::{SystemTime, UNIX_EPOCH};
+
+use anyhow::{Context, Result, bail};
+use axum::Json;
+use axum::body::{Body, to_bytes};
+use axum::extract::{Request, State};
+use axum::http::header::{CONNECTION, CONTENT_TYPE};
+use axum::http::{HeaderMap, HeaderName, HeaderValue, StatusCode};
+use axum::middleware::Next;
+use axum::response::{IntoResponse, Response};
+use sha2::{Digest, Sha256};
+
+pub const READY_PREFIX: &str = "LYRICFORGE_RUNTIME_READY ";
+pub const PROTOCOL_VERSION: u32 = 1;
+pub const TIMESTAMP_HEADER: &str = "x-lyricforge-timestamp";
+pub const NONCE_HEADER: &str = "x-lyricforge-nonce";
+pub const SIGNATURE_HEADER: &str = "x-lyricforge-signature";
+pub const PROOF_HEADER: &str = "x-lyricforge-proof";
+
+const SECRET_HEX_LEN: usize = 64;
+const NONCE_HEX_LEN: usize = 32;
+const SIGNATURE_HEX_LEN: usize = 64;
+const MAX_TIMESTAMP_DIGITS: usize = 16;
+const MAX_CLOCK_SKEW_MS: u64 = 120_000;
+const MAX_TRACKED_NONCES: usize = 65_536;
+/// Same limit as upstream `DefaultBodyLimit::max(MAX_BODY_BYTES)`.
+const MAX_AUTHENTICATED_BODY_BYTES: usize = 8 * 1024 * 1024;
+const STREAMING_BODY_DIGEST: &str = "unsigned-stream";
+
+/// Per-launch shared secret plus replay cache.
+pub struct SessionAuth {
+    key: [u8; 32],
+    seen_nonces: Mutex<HashMap<String, u64>>,
+}
+
+impl std::fmt::Debug for SessionAuth {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.write_str("SessionAuth { key: <redacted> }")
+    }
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+struct AuthHeaders {
+    timestamp: String,
+    timestamp_ms: u64,
+    nonce: String,
+    signature: String,
+}
+
+impl SessionAuth {
+    /// Parses the secret line written by LyricForge. Errors never echo it.
+    pub fn from_secret_hex(secret: &str) -> Result<Self> {
+        let secret = secret.trim_end_matches(['\r', '\n']);
+        if secret.len() != SECRET_HEX_LEN || !is_lower_hex(secret, SECRET_HEX_LEN) {
+            bail!("session secret must be exactly {SECRET_HEX_LEN} lowercase hex characters");
+        }
+        let bytes = decode_lower_hex(secret)
+            .ok_or_else(|| anyhow::anyhow!("session secret must be lowercase hex"))?;
+        let mut key = [0u8; 32];
+        key.copy_from_slice(&bytes);
+        if key.iter().all(|byte| *byte == 0) {
+            bail!("session secret must not be all zeroes");
+        }
+        Ok(Self {
+            key,
+            seen_nonces: Mutex::new(HashMap::new()),
+        })
+    }
+
+    /// Reads exactly one secret line from stdin.
+    pub fn read_from_stdin() -> Result<Arc<Self>> {
+        let mut line = String::new();
+        let read = std::io::stdin()
+            .lock()
+            .read_line(&mut line)
+            .context("failed to read the LyricForge session secret from stdin")?;
+        if read == 0 {
+            bail!("stdin closed before the LyricForge session secret was provided");
+        }
+        let parsed = Self::from_secret_hex(&line);
+        let mut scrub = line.into_bytes();
+        scrub.fill(0);
+        drop(scrub);
+        Ok(Arc::new(parsed?))
+    }
+
+    pub fn sign(&self, message: &str) -> String {
+        to_lower_hex(&hmac_sha256(&self.key, message.as_bytes()))
+    }
+
+    /// Line written to stdout once the listener is bound.
+    pub fn ready_line(&self, port: u16) -> String {
+        format!(
+            "{READY_PREFIX}{{\"protocol\":{PROTOCOL_VERSION},\"port\":{port},\"proof\":\"{}\"}}",
+            self.sign(&ready_message(port))
+        )
+    }
+
+    pub fn response_proof(&self, nonce: &str, status: u16, body: Option<&[u8]>) -> String {
+        let digest = body.map_or_else(|| STREAMING_BODY_DIGEST.to_string(), sha256_hex);
+        self.sign(&response_message(nonce, status, &digest))
+    }
+
+    fn verify_request(
+        &self,
+        headers: &AuthHeaders,
+        method: &str,
+        path_and_query: &str,
+        body: &[u8],
+        now_ms: u64,
+    ) -> Result<(), &'static str> {
+        if now_ms.abs_diff(headers.timestamp_ms) > MAX_CLOCK_SKEW_MS {
+            return Err("timestamp outside the accepted window");
+        }
+        let expected = self.sign(&request_message(
+            method,
+            path_and_query,
+            &headers.timestamp,
+            &headers.nonce,
+            &sha256_hex(body),
+        ));
+        if !constant_time_eq(expected.as_bytes(), headers.signature.as_bytes()) {
+            return Err("signature mismatch");
+        }
+
+        let mut seen = self
+            .seen_nonces
+            .lock()
+            .map_err(|_| "nonce cache unavailable")?;
+        seen.retain(|_, seen_at| now_ms.saturating_sub(*seen_at) <= 2 * MAX_CLOCK_SKEW_MS);
+        if seen.contains_key(headers.nonce.as_str()) {
+            return Err("replayed nonce");
+        }
+        if seen.len() >= MAX_TRACKED_NONCES {
+            return Err("nonce cache full");
+        }
+        seen.insert(headers.nonce.clone(), now_ms);
+        Ok(())
+    }
+}
+
+pub fn ready_message(port: u16) -> String {
+    format!("v1-ready\n{port}")
+}
+
+pub fn request_message(
+    method: &str,
+    path_and_query: &str,
+    timestamp: &str,
+    nonce: &str,
+    body_sha256_hex: &str,
+) -> String {
+    format!("v1-request\n{method}\n{path_and_query}\n{timestamp}\n{nonce}\n{body_sha256_hex}")
+}
+
+pub fn response_message(nonce: &str, status: u16, body_digest: &str) -> String {
+    format!("v1-response\n{nonce}\n{status}\n{body_digest}")
+}
+
+/// Session mode refuses anything other than a literal loopback IP.
+pub fn session_bind_address(host: &str, port: u16) -> Result<SocketAddr> {
+    let ip: IpAddr = host.parse().map_err(|_| {
+        anyhow::anyhow!(
+            "--host must be a literal loopback IP when --lyricforge-session-stdin is set, got {host:?}"
+        )
+    })?;
+    if !ip.is_loopback() {
+        bail!("--lyricforge-session-stdin only binds loopback addresses; refusing {ip}");
+    }
+    Ok(SocketAddr::new(ip, port))
+}
+
+/// Binds the listener inside the runtime. On Windows the socket is marked
+/// `SO_EXCLUSIVEADDRUSE` first: without it another process of the same user can
+/// bind the same address with `SO_REUSEADDR` and steal connections. Unix
+/// listeners are exclusive unless both sockets opt into `SO_REUSEPORT`, which
+/// this socket never does.
+pub fn bind_exclusive_listener(addr: SocketAddr) -> Result<tokio::net::TcpListener> {
+    let socket = if addr.is_ipv4() {
+        tokio::net::TcpSocket::new_v4()
+    } else {
+        tokio::net::TcpSocket::new_v6()
+    }
+    .context("failed to create the HTTP listener socket")?;
+    #[cfg(windows)]
+    windows_exclusive::enable(&socket)?;
+    socket
+        .bind(addr)
+        .with_context(|| format!("failed to bind HTTP server at {addr}"))?;
+    socket
+        .listen(1024)
+        .context("failed to listen on the HTTP server socket")
+}
+
+/// Writes the ready line (port + proof, never the secret) to stdout.
+pub fn announce_ready(auth: &SessionAuth, port: u16) -> Result<()> {
+    let mut stdout = std::io::stdout().lock();
+    writeln!(stdout, "{}", auth.ready_line(port)).context("failed to announce runtime port")?;
+    stdout.flush().context("failed to flush runtime port announcement")
+}
+
+/// Exits the process once the parent closes stdin (or dies).
+pub fn exit_when_stdin_closes() -> Result<()> {
+    std::thread::Builder::new()
+        .name("lyricforge-session-stdin".to_string())
+        .spawn(|| {
+            let stdin = std::io::stdin();
+            let mut handle = stdin.lock();
+            let mut sink = [0u8; 256];
+            loop {
+                match handle.read(&mut sink) {
+                    Ok(0) => break,
+                    Ok(_) => {}
+                    Err(error) if error.kind() == std::io::ErrorKind::Interrupted => {}
+                    Err(_) => break,
+                }
+            }
+            tracing::info!("LyricForge session control pipe closed; shutting down runtime");
+            std::process::exit(0);
+        })
+        .context("failed to start the LyricForge stdin watcher")?;
+    Ok(())
+}
+
+/// Axum middleware enforcing the session signature on every route.
+pub async fn require_session_auth(
+    State(auth): State<Arc<SessionAuth>>,
+    request: Request,
+    next: Next,
+) -> Response {
+    let (parts, body) = request.into_parts();
+    let headers = match parse_auth_headers(&parts.headers) {
+        Ok(headers) => headers,
+        Err(reason) => return reject(StatusCode::UNAUTHORIZED, reason),
+    };
+    let Ok(body) = to_bytes(body, MAX_AUTHENTICATED_BODY_BYTES).await else {
+        return reject(StatusCode::PAYLOAD_TOO_LARGE, "request body too large");
+    };
+    let method = parts.method.as_str().to_string();
+    let path_and_query = parts
+        .uri
+        .path_and_query()
+        .map_or_else(|| parts.uri.path().to_string(), |value| value.as_str().to_string());
+    if let Err(reason) =
+        auth.verify_request(&headers, &method, &path_and_query, &body, unix_millis())
+    {
+        return reject(StatusCode::UNAUTHORIZED, reason);
+    }
+
+    let response = next.run(Request::from_parts(parts, Body::from(body))).await;
+    sign_response(&auth, &headers.nonce, response).await
+}
+
+async fn sign_response(auth: &SessionAuth, nonce: &str, response: Response) -> Response {
+    let status = response.status().as_u16();
+    let streaming = response.status() == StatusCode::SWITCHING_PROTOCOLS
+        || response
+            .headers()
+            .get(CONTENT_TYPE)
+            .and_then(|value| value.to_str().ok())
+            .is_some_and(|value| value.starts_with("text/event-stream"));
+    if streaming {
+        let mut response = response;
+        insert_proof(
+            response.headers_mut(),
+            &auth.response_proof(nonce, status, None),
+        );
+        return response;
+    }
+
+    let (mut parts, body) = response.into_parts();
+    let Ok(bytes) = to_bytes(body, usize::MAX).await else {
+        return StatusCode::INTERNAL_SERVER_ERROR.into_response();
+    };
+    insert_proof(
+        &mut parts.headers,
+        &auth.response_proof(nonce, status, Some(&bytes)),
+    );
+    Response::from_parts(parts, Body::from(bytes))
+}
+
+fn insert_proof(headers: &mut HeaderMap, proof: &str) {
+    if let Ok(value) = HeaderValue::from_str(proof) {
+        headers.insert(HeaderName::from_static(PROOF_HEADER), value);
+    }
+}
+
+fn reject(status: StatusCode, reason: &'static str) -> Response {
+    tracing::warn!(reason, "rejected unauthenticated LyricForge runtime request");
+    // The request body may be unread at this point, so the connection cannot
+    // be reused safely. Say so explicitly instead of letting a client pool a
+    // socket the server is about to drop; unauthenticated peers also do not
+    // get to keep a connection open.
+    (
+        status,
+        [(CONNECTION, "close")],
+        Json(serde_json::json!({
+            "error": {
+                "message": "unauthorized",
+                "type": "authentication_error"
+            }
+        })),
+    )
+        .into_response()
+}
+
+fn parse_auth_headers(headers: &HeaderMap) -> Result<AuthHeaders, &'static str> {
+    let timestamp = header_str(headers, TIMESTAMP_HEADER).ok_or("missing timestamp")?;
+    let nonce = header_str(headers, NONCE_HEADER).ok_or("missing nonce")?;
+    let signature = header_str(headers, SIGNATURE_HEADER).ok_or("missing signature")?;
+    if timestamp.is_empty()
+        || timestamp.len() > MAX_TIMESTAMP_DIGITS
+        || !timestamp.bytes().all(|byte| byte.is_ascii_digit())
+    {
+        return Err("malformed timestamp");
+    }
+    let timestamp_ms = timestamp
+        .parse::<u64>()
+        .map_err(|_| "malformed timestamp")?;
+    if !is_lower_hex(nonce, NONCE_HEX_LEN) {
+        return Err("malformed nonce");
+    }
+    if !is_lower_hex(signature, SIGNATURE_HEX_LEN) {
+        return Err("malformed signature");
+    }
+    Ok(AuthHeaders {
+        timestamp: timestamp.to_string(),
+        timestamp_ms,
+        nonce: nonce.to_string(),
+        signature: signature.to_string(),
+    })
+}
+
+fn header_str<'a>(headers: &'a HeaderMap, name: &str) -> Option<&'a str> {
+    let mut values = headers.get_all(name).iter();
+    let first = values.next()?;
+    if values.next().is_some() {
+        return None;
+    }
+    first.to_str().ok()
+}
+
+fn unix_millis() -> u64 {
+    SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .map_or(0, |elapsed| elapsed.as_millis() as u64)
+}
+
+pub fn sha256_hex(bytes: &[u8]) -> String {
+    let digest = Sha256::digest(bytes);
+    to_lower_hex(&digest)
+}
+
+pub fn hmac_sha256(key: &[u8], message: &[u8]) -> [u8; 32] {
+    const BLOCK_SIZE: usize = 64;
+    let mut key_block = [0u8; BLOCK_SIZE];
+    if key.len() > BLOCK_SIZE {
+        let digest = Sha256::digest(key);
+        key_block[..digest.len()].copy_from_slice(&digest);
+    } else {
+        key_block[..key.len()].copy_from_slice(key);
+    }
+    let mut inner_pad = [0x36u8; BLOCK_SIZE];
+    let mut outer_pad = [0x5cu8; BLOCK_SIZE];
+    for index in 0..BLOCK_SIZE {
+        inner_pad[index] ^= key_block[index];
+        outer_pad[index] ^= key_block[index];
+    }
+    let mut inner = Sha256::new();
+    inner.update(inner_pad);
+    inner.update(message);
+    let inner_digest = inner.finalize();
+    let mut outer = Sha256::new();
+    outer.update(outer_pad);
+    outer.update(inner_digest);
+    let digest = outer.finalize();
+    let mut out = [0u8; 32];
+    out.copy_from_slice(&digest);
+    out
+}
+
+fn constant_time_eq(left: &[u8], right: &[u8]) -> bool {
+    if left.len() != right.len() {
+        return false;
+    }
+    left.iter()
+        .zip(right.iter())
+        .fold(0u8, |difference, (a, b)| difference | (a ^ b))
+        == 0
+}
+
+fn is_lower_hex(value: &str, expected_len: usize) -> bool {
+    value.len() == expected_len
+        && value
+            .bytes()
+            .all(|byte| byte.is_ascii_digit() || (b'a'..=b'f').contains(&byte))
+}
+
+fn decode_lower_hex(value: &str) -> Option<Vec<u8>> {
+    fn nibble(byte: u8) -> Option<u8> {
+        match byte {
+            b'0'..=b'9' => Some(byte - b'0'),
+            b'a'..=b'f' => Some(byte - b'a' + 10),
+            _ => None,
+        }
+    }
+    let bytes = value.as_bytes();
+    if bytes.len() % 2 != 0 {
+        return None;
+    }
+    bytes
+        .chunks_exact(2)
+        .map(|pair| Some((nibble(pair[0])? << 4) | nibble(pair[1])?))
+        .collect()
+}
+
+fn to_lower_hex(bytes: &[u8]) -> String {
+    const DIGITS: &[u8; 16] = b"0123456789abcdef";
+    let mut out = String::with_capacity(bytes.len() * 2);
+    for byte in bytes {
+        out.push(DIGITS[usize::from(byte >> 4)] as char);
+        out.push(DIGITS[usize::from(byte & 0x0f)] as char);
+    }
+    out
+}
