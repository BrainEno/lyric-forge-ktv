+    let first = send(&base, "POST", "/v1/transcribe", &signed.headers, &body)?;
+    if first.status != 200 {
+        bail!("first signed request failed: {}", first.text());
+    }
+    assert_unauthorized(
+        &send(&base, "POST", "/v1/transcribe", &signed.headers, &body)?,
+        "replayed nonce",
+    )?;
+
+    let signed = sign(&server.key, "POST", "/v1/transcribe", &body);
+    let mut tampered = body.clone();
+    tampered.extend_from_slice(b" ");
+    assert_unauthorized(
+        &send(&base, "POST", "/v1/transcribe", &signed.headers, &tampered)?,
+        "tampered body",
+    )?;
+
+    let signed = sign(&server.key, "POST", "/v1/transcribe", &body);
+    assert_unauthorized(
+        &send(&base, "POST", "/v1/align", &signed.headers, &body)?,
+        "signature replayed on another route",
+    )?;
+
+    let stale = sign_at(
+        &server.key,
+        "GET",
+        "/healthz",
+        b"",
+        unix_millis() - 10 * 60 * 1000,
+        &fresh_nonce(),
+    );
+    assert_unauthorized(
+        &send(&base, "GET", "/healthz", &stale.headers, b"")?,
+        "stale timestamp",
+    )?;
+    Ok(())
+}
+
+#[test]
+fn previous_session_secret_cannot_access_a_restarted_runtime() -> Result<()> {
+    let old = spawn_session_server(SECRET_A)?;
+    let old_key = old.key.clone();
+    drop(old);
+
+    let new = spawn_session_server(SECRET_B)?;
+    let base = new.base_url();
+    let body = transcribe_body();
+    let stale_session = sign(&old_key, "POST", "/v1/transcribe", &body);
+    assert_unauthorized(
+        &send(&base, "POST", "/v1/transcribe", &stale_session.headers, &body)?,
+        "old session secret",
+    )?;
+    let fresh = sign(&new.key, "POST", "/v1/transcribe", &body);
+    let reply = send(&base, "POST", "/v1/transcribe", &fresh.headers, &body)?;
+    if reply.status != 200 {
+        bail!("new session secret was rejected: {}", reply.text());
+    }
+    Ok(())
+}
