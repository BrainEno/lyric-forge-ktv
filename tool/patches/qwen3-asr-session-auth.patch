+#[test]
+fn session_mode_fails_closed_on_bad_secret_or_non_loopback_host() -> Result<()> {
+    for (secret, host) in [
+        ("not-hex", "127.0.0.1"),
+        ("", "127.0.0.1"),
+        (SECRET_A, "0.0.0.0"),
+        (SECRET_A, "localhost"),
+    ] {
+        let mut child = session_command(&["--host", host, "--port", "0"]).spawn()?;
+        let mut stdin = child.stdin.take().context("missing stdin")?;
+        let _ = writeln!(stdin, "{secret}");
+        let _ = stdin.flush();
+        let status = wait_with_timeout(&mut child, Duration::from_secs(30))?;
+        let mut stdout = String::new();
+        if let Some(mut out) = child.stdout.take() {
+            let _ = out.read_to_string(&mut stdout);
+        }
+        drop(stdin);
+        if status.success() {
+            bail!("session mode accepted secret={secret:?} host={host}");
+        }
+        if stdout.contains(READY_PREFIX) {
+            bail!("session mode announced a port for secret={secret:?} host={host}");
+        }
+    }
+    Ok(())
+}
