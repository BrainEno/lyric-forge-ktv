+    let health = sign(&server.key, "GET", "/healthz", b"");
+    let reply = send(&base, "GET", "/healthz", &health.headers, b"")?;
+    if reply.status != 200 || reply.json()["ok"] != Value::Bool(true) {
+        bail!("signed healthz failed: {} {}", reply.status, reply.text());
+    }
+    if reply.proof.as_deref() != Some(expected_proof(&server.key, &health.nonce, &reply).as_str())
+    {
