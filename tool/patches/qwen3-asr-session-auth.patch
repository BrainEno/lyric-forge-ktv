+#[test]
+fn session_server_rejects_every_unauthenticated_route() -> Result<()> {
+    let server = spawn_session_server(SECRET_A)?;
+    let base = server.base_url();
+    let body = transcribe_body();
+
+    assert_unauthorized(&send(&base, "GET", "/healthz", &[], b"")?, "healthz")?;
+    assert_unauthorized(&send(&base, "GET", "/", &[], b"")?, "root")?;
+    assert_unauthorized(&send(&base, "GET", "/v1/models", &[], b"")?, "models")?;
+    assert_unauthorized(
