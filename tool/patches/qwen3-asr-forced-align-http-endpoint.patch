+fn run_align_real(real: &RealWorkerState, req: AlignRequest) -> ApiResult<Value> {
+    let aligner = real.forced_aligner_default.as_ref().ok_or_else(|| {
+        ApiError::bad_request(
+            "forced alignment requires server --forced-aligner at startup",
+        )
+    })?;
+
+    let audio_inputs = vec![crate::audio_arg::parse_audio_arg(req.audio.as_str())];
+    let texts = vec![req.text];
+    let languages = vec![req.language];
+    let results = aligner
+        .align(&audio_inputs, &texts, &languages)
+        .map_err(|e| ApiError::bad_request(format!("forced alignment failed: {e:#}")))?;
+    let result = results
+        .into_iter()
+        .next()
+        .ok_or_else(|| ApiError::internal("forced aligner returned no result"))?;
+
+    let items = result
+        .items
+        .into_iter()
+        .map(|item| {
+            serde_json::json!({
+                "text": item.text,
+                "start_time": item.start_time,
+                "end_time": item.end_time,
+            })
+        })
+        .collect::<Vec<_>>();
+
+    Ok(serde_json::json!({ "results": [{ "items": items }] }))
+}
