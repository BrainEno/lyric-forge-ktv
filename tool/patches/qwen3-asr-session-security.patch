+fn read_runtime_ready_line(stdout: std::process::ChildStdout) -> Result<String> {
+    let (sender, receiver) = std::sync::mpsc::channel();
+    thread::spawn(move || {
+        let mut reader = BufReader::new(stdout);
+        let mut line = String::new();
+        loop {
+            line.clear();
+            match reader.read_line(&mut line) {
+                Ok(0) | Err(_) => break,
+                Ok(_) if line.starts_with(&format!("{READY_PREFIX}\t")) => {
+                    let _ = sender.send(line.clone());
+                    return;
+                }
+                Ok(_) => {}
+            }
+        }
+    });
+    receiver
+        .recv_timeout(Duration::from_secs(600))
+        .context("native runtime did not report its bound TLS listener")
+}
+
+fn parse_runtime_ready(line: &str) -> Result<(u16, Vec<u8>)> {
+    let mut fields = line.trim_end().split('\t');
+    if fields.next() != Some(READY_PREFIX) {
+        bail!("invalid native runtime readiness record");
+    }
+    let port = fields
+        .next()
+        .ok_or_else(|| anyhow::anyhow!("missing native runtime port"))?
+        .parse::<u16>()?;
+    if port == 0 {
+        bail!("native runtime reported port zero instead of its bound port");
+    }
+    let certificate = STANDARD.decode(
+        fields
+            .next()
+            .ok_or_else(|| anyhow::anyhow!("missing native runtime certificate"))?,
+    )?;
+    if fields.next().is_some() || certificate.is_empty() || certificate.len() > 8192 {
+        bail!("invalid native runtime TLS identity record");
+    }
+    Ok((port, certificate))
+}
