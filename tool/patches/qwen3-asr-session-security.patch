+++ b/qwen3_asr_cli/src/session_security.rs
@@ -0,0 +1,179 @@
+use std::future::Future;
+use std::io;
+use std::net::SocketAddr;
+use std::sync::Arc;
+use std::time::Duration;
+
+use anyhow::{Context, Result, anyhow};
+use axum::extract::{Request, State};
+use axum::http::{StatusCode, header::AUTHORIZATION};
+use axum::middleware::Next;
+use axum::response::{IntoResponse, Response};
+use axum::serve::Listener;
+use base64::Engine;
+use base64::engine::general_purpose::{STANDARD, URL_SAFE_NO_PAD};
+use rcgen::generate_simple_self_signed;
+use tokio::net::{TcpListener, TcpStream};
+use tokio::sync::{Semaphore, mpsc};
+use tokio::time::timeout;
+use tokio_rustls::TlsAcceptor;
+use tokio_rustls::rustls::{self, pki_types::PrivateKeyDer};
+use tokio_rustls::server::TlsStream;
+
+pub const SESSION_TOKEN_ENV: &str = "LYRICFORGE_QWEN_SESSION_TOKEN";
+pub const READY_PREFIX: &str = "LYRICFORGE_QWEN_READY";
+const TOKEN_BYTES: usize = 32;
+const TLS_HANDSHAKE_TIMEOUT: Duration = Duration::from_secs(5);
+const MAX_PENDING_TLS_HANDSHAKES: usize = 32;
+const ACCEPTED_CONNECTION_BUFFER: usize = 32;
+
+#[derive(Clone)]
+pub struct SessionToken(Arc<[u8; TOKEN_BYTES]>);
+
+impl SessionToken {
+    pub fn from_environment() -> Result<Self> {
+        let encoded = std::env::var(SESSION_TOKEN_ENV)
+            .map_err(|_| anyhow!("required local runtime session credential is missing"))?;
+        let decoded = URL_SAFE_NO_PAD
+            .decode(encoded.as_bytes())
+            .map_err(|_| anyhow!("local runtime session credential has an invalid format"))?;
+        let bytes: [u8; TOKEN_BYTES] = decoded
+            .as_slice()
+            .try_into()
+            .map_err(|_| anyhow!("local runtime session credential has an invalid length"))?;
+        Ok(Self(Arc::new(bytes)))
+    }
+}
+
+pub async fn require_session_auth(
+    State(expected): State<SessionToken>,
+    request: Request,
+    next: Next,
+) -> Response {
+    let authorized = request
+        .headers()
+        .get(AUTHORIZATION)
+        .and_then(|value| value.to_str().ok())
+        .and_then(|value| value.strip_prefix("Bearer "))
+        .filter(|value| value.len() == 43)
+        .and_then(|value| URL_SAFE_NO_PAD.decode(value.as_bytes()).ok())
+        .is_some_and(|candidate| constant_time_equal(candidate.as_slice(), expected.0.as_slice()));
+
+    if authorized {
+        next.run(request).await
+    } else {
+        StatusCode::UNAUTHORIZED.into_response()
+    }
+}
+
+fn constant_time_equal(left: &[u8], right: &[u8]) -> bool {
+    if left.len() != right.len() {
+        return false;
+    }
+
+    left.iter()
+        .zip(right)
+        .fold(0_u8, |difference, (left, right)| {
+            difference | (*left ^ *right)
+        })
+        == 0
+}
+
+pub struct LocalTlsListener {
+    address: SocketAddr,
+    accepted: mpsc::Receiver<(TlsStream<TcpStream>, SocketAddr)>,
+}
+
+impl LocalTlsListener {
+    pub async fn bind(host: &str, port: u16) -> Result<(Self, String)> {
+        if host != "127.0.0.1" {
+            return Err(anyhow!("session-secure Qwen serve must bind IPv4 loopback only"));
+        }
+        if port != 0 {
+            return Err(anyhow!("session-secure Qwen serve must request an OS-assigned port"));
+        }
+        let certified = generate_simple_self_signed(vec!["127.0.0.1".to_owned()])
+            .context("failed to create an ephemeral local runtime certificate")?;
+        let certificate = certified.cert.der().clone();
+        if certificate.len() > 8192 {
+            return Err(anyhow!(
+                "ephemeral local runtime certificate exceeds the readiness-record limit"
+            ));
+        }
+        let private_key = PrivateKeyDer::Pkcs8(certified.key_pair.serialize_der().into());
+
+        let provider = Arc::new(rustls::crypto::ring::default_provider());
+        let server_config = rustls::ServerConfig::builder_with_provider(provider)
+            .with_safe_default_protocol_versions()
+            .context("failed to select local runtime TLS versions")?
+            .with_no_client_auth()
+            .with_single_cert(vec![certificate.clone()], private_key)
+            .context("failed to configure local runtime TLS certificate")?;
+        let acceptor = TlsAcceptor::from(Arc::new(server_config));
+
+        let address = format!("{host}:{port}");
+        let listener = TcpListener::bind(address.as_str())
+            .await
+            .with_context(|| format!("failed to bind local TLS listener at {address}"))?;
+        let local_address = listener
+            .local_addr()
+            .context("failed to read local runtime listener address")?;
+
+        let (sender, accepted) = mpsc::channel(ACCEPTED_CONNECTION_BUFFER);
+        let handshake_slots = Arc::new(Semaphore::new(MAX_PENDING_TLS_HANDSHAKES));
+        tokio::spawn(async move {
+            loop {
+                match listener.accept().await {
+                    Ok((stream, peer)) => {
+                        let Ok(slot) = Arc::clone(&handshake_slots).try_acquire_owned() else {
+                            drop(stream);
+                            continue;
+                        };
+                        let acceptor = acceptor.clone();
+                        let sender = sender.clone();
+                        tokio::spawn(async move {
+                            let _slot = slot;
+                            if let Ok(Ok(stream)) =
+                                timeout(TLS_HANDSHAKE_TIMEOUT, acceptor.accept(stream)).await
+                            {
+                                let _ = sender.send((stream, peer)).await;
+                            }
+                        });
+                    }
+                    Err(error) => {
+                        tracing::warn!(error = %error, "local Qwen listener accept failed");
+                        tokio::time::sleep(Duration::from_millis(100)).await;
+                    }
+                }
+            }
+        });
+
+        Ok((
+            Self {
+                address: local_address,
+                accepted,
+            },
+            STANDARD.encode(certificate.as_ref()),
+        ))
+    }
+}
+
+impl Listener for LocalTlsListener {
+    type Io = TlsStream<TcpStream>;
+    type Addr = SocketAddr;
+
+    fn accept(&mut self) -> impl Future<Output = (Self::Io, Self::Addr)> + Send {
+        async move {
+            loop {
+                match self.accepted.recv().await {
+                    Some(accepted) => return accepted,
+                    None => std::future::pending::<(Self::Io, Self::Addr)>().await,
+                }
+            }
+        }
+    }
+
+    fn local_addr(&self) -> io::Result<Self::Addr> {
+        Ok(self.address)
+    }
+}
